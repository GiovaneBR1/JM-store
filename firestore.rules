rules_version = '2';

// Regras do Firestore da JM Store. Cole este arquivo em:
// Console do Firebase → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Lista de administradores: cada documento tem como ID o UID da conta.
    // Só é editada pelo console; cada pessoa pode apenas conferir se ela mesma é admin.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Dados da gestão: somente administradores leem e gravam.
    match /products/{id} { allow read, write: if isAdmin(); }
    match /customers/{id} { allow read, write: if isAdmin(); }
    match /sales/{id} { allow read, write: if isAdmin(); }
  }
}
