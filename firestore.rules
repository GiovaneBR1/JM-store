rules_version = '2';

// Regras do Firestore da JM Store. Cole este arquivo em:
// Console do Firebase → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Lista de administradores: cada documento tem como ID o UID da conta.
    // Só é editada pelo console; cada pessoa pode apenas conferir se ela mesma é admin.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Dados da gestão: somente administradores leem e gravam.
    match /products/{id} { allow read, write: if isAdmin(); }
    match /customers/{id} { allow read, write: if isAdmin(); }
    match /sales/{id} { allow read, write: if isAdmin(); }

    // Vitrine: cópia pública dos produtos (sem o custo), mantida pela gestão.
    match /catalog/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos feitos pelo site: o cliente logado cria os seus e acompanha só os dele;
    // o admin vê todos e muda o status.
    match /orders/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'novo';
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin() || canRequestReturn();
      allow delete: if isAdmin();
    }

    // O cliente pode pedir devolução uma única vez, até 7 dias depois de a compra ser finalizada,
    // e só consegue gravar o campo "return" (com status "solicitada").
    function canRequestReturn() {
      return request.auth != null
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'entregue'
        && !('return' in resource.data)
        && request.time < resource.data.finishedAt + duration.value(7, 'd')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['return'])
        && request.resource.data['return'].status == 'solicitada';
    }

    // Cupons: o cliente só consegue conferir um código que já sabe (o ID do documento);
    // listar todos os cupons e editá-los é só para admin.
    match /coupons/{code} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
  }
}
