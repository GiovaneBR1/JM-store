rules_version = '2';

// Regras do Firestore da JM Store. Cole este arquivo em:
// Console do Firebase → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Lista de administradores: cada documento tem como ID o UID da conta.
    // Só é editada pelo console; cada pessoa pode apenas conferir se ela mesma é admin.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Dados da gestão: somente administradores leem e gravam.
    match /products/{id} { allow read, write: if isAdmin(); }
    match /customers/{id} { allow read, write: if isAdmin(); }
    match /sales/{id} { allow read, write: if isAdmin(); }
    match /settings/{id} { allow read, write: if isAdmin(); }
    // Aparelhos da gestão que recebem notificação de pedido (o ID é o token do aparelho).
    match /adminTokens/{token} { allow read, write: if isAdmin(); }

    // Categorias: viram os filtros e a vitrine da loja, então todos leem; só o admin edita.
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Dados da loja (WhatsApp, PIX, endereço, frete): a loja e os e-mails leem; só o admin edita.
    match /site/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Vitrine: cópia pública dos produtos (sem o custo), mantida pela gestão.
    match /catalog/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos feitos pelo site: o cliente logado cria os seus e acompanha só os dele;
    // o admin vê todos e muda o status.
    // Na criação, só os campos que o site envia: nada de "reservado", "venda lançada", "demonstração" etc.
    // Preços, cupom, frete e total são conferidos no servidor (functions/conferir.js).
    match /orders/{id} {
      allow create: if isAdmin() || (request.auth != null
        && request.resource.data.keys().hasOnly(['code', 'uid', 'status', 'channel', 'createdAt', 'customer', 'items',
             'subtotal', 'coupon', 'delivery', 'payment', 'notes', 'total'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'novo'
        && request.resource.data.channel == 'site'
        && request.resource.data.createdAt == request.time
        && request.resource.data.code is string && request.resource.data.code.size() <= 20
        && request.resource.data.customer is map
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50
        && request.resource.data.delivery is map && request.resource.data.delivery.type in ['pickup', 'delivery']
        && request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000);
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin() || canRequestReturn();
      allow delete: if isAdmin();
    }

    // O cliente pode pedir devolução uma única vez, até 7 dias depois de a compra ser finalizada,
    // e só consegue gravar o campo "return" (com status "solicitada").
    function canRequestReturn() {
      return request.auth != null
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'entregue'
        && !('return' in resource.data)
        && request.time < resource.data.finishedAt + duration.value(7, 'd')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['return'])
        && request.resource.data['return'].keys().hasOnly(['status', 'reason', 'details', 'requestedAt'])
        && request.resource.data['return'].status == 'solicitada'
        && request.resource.data['return'].details.size() <= 500;
    }

    // Pedidos personalizados: o cliente logado descreve o produto que procura (com foto opcional, já reduzida)
    // e acompanha só os dele; o admin vê todos e responde.
    match /requests/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['code', 'uid', 'status', 'channel', 'createdAt', 'customer', 'desc', 'model',
             'link', 'photo', 'qty', 'budget', 'note'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'novo'
        && request.resource.data.createdAt == request.time
        && request.resource.data.note == ''
        && request.resource.data.desc is string && request.resource.data.desc.size() <= 1000
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 600000;
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Cupons: o cliente só consegue conferir um código que já sabe (o ID do documento);
    // listar todos os cupons e editá-los é só para admin.
    match /coupons/{code} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
  }
}
